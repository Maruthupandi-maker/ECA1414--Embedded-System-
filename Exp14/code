
#include <Arduino.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "freertos/semphr.h"

// Semaphore and Mutex handles
SemaphoreHandle_t binarySemaphore;
SemaphoreHandle_t countingSemaphore;
SemaphoreHandle_t mutexSemaphore;
SemaphoreHandle_t serialMutex;

// Shared variable
int sharedCounter = 0;

// Safe Serial printing
void printMessage(const char *message)
{
  xSemaphoreTake(serialMutex, portMAX_DELAY);

  Serial.println(message);

  xSemaphoreGive(serialMutex);
}

// Task 1: Binary Semaphore Sender
void BinarySender(void *pvParameters)
{
  while (1)
  {
    printMessage("Binary Sender: Sending signal");

    xSemaphoreGive(binarySemaphore);

    vTaskDelay(pdMS_TO_TICKS(2000));
  }
}

// Task 2: Binary Semaphore Receiver
void BinaryReceiver(void *pvParameters)
{
  while (1)
  {
    if (xSemaphoreTake(binarySemaphore, portMAX_DELAY) == pdTRUE)
    {
      printMessage("Binary Receiver: Signal Received");
    }
  }
}

// Task 3: Counting Semaphore Producer
void CountingProducer(void *pvParameters)
{
  while (1)
  {
    printMessage("Producer: Adding an item");

    if (xSemaphoreGive(countingSemaphore) == pdTRUE)
    {
      printMessage("Producer: Item added successfully");
    }
    else
    {
      printMessage("Producer: Semaphore is full");
    }

    vTaskDelay(pdMS_TO_TICKS(1000));
  }
}

// Task 4: Counting Semaphore Consumer
void CountingConsumer(void *pvParameters)
{
  while (1)
  {
    if (xSemaphoreTake(countingSemaphore, portMAX_DELAY) == pdTRUE)
    {
      printMessage("Consumer: Item consumed");
    }

    vTaskDelay(pdMS_TO_TICKS(1500));
  }
}

// Task 5: Shared Data Increment
void CounterTask1(void *pvParameters)
{
  while (1)
  {
    xSemaphoreTake(mutexSemaphore, portMAX_DELAY);

    sharedCounter++;

    Serial.print("Task 1 - Shared Counter: ");
    Serial.println(sharedCounter);

    xSemaphoreGive(mutexSemaphore);

    vTaskDelay(pdMS_TO_TICKS(500));
  }
}

// Task 6: Shared Data Increment
void CounterTask2(void *pvParameters)
{
  while (1)
  {
    xSemaphoreTake(mutexSemaphore, portMAX_DELAY);

    sharedCounter++;

    Serial.print("Task 2 - Shared Counter: ");
    Serial.println(sharedCounter);

    xSemaphoreGive(mutexSemaphore);

    vTaskDelay(pdMS_TO_TICKS(700));
  }
}

void setup()
{
  Serial.begin(115200);

  delay(1000);

  Serial.println("\nESP32 FreeRTOS Experiment 14");
  Serial.println("Task Synchronization Started");

  // Create Binary Semaphore
  binarySemaphore = xSemaphoreCreateBinary();

  // Create Counting Semaphore
  countingSemaphore = xSemaphoreCreateCounting(5, 0);

  // Create Mutex
  mutexSemaphore = xSemaphoreCreateMutex();

  // Create Serial Mutex
  serialMutex = xSemaphoreCreateMutex();

  // Check semaphore creation
  if (binarySemaphore == NULL ||
      countingSemaphore == NULL ||
      mutexSemaphore == NULL ||
      serialMutex == NULL)
  {
    Serial.println("Semaphore Creation Failed!");
    while (1)
    {
      delay(1000);
    }
  }

  Serial.println("All Semaphores Created Successfully");

  // Create Binary Semaphore Tasks
  xTaskCreatePinnedToCore(
    BinarySender, "BinarySender", 4096, NULL, 2, NULL, 1);

  xTaskCreatePinnedToCore(
    BinaryReceiver, "BinaryReceiver", 4096, NULL, 2, NULL, 1);

  // Create Counting Semaphore Tasks
  xTaskCreatePinnedToCore(
    CountingProducer, "Producer", 4096, NULL, 2, NULL, 1);

  xTaskCreatePinnedToCore(
    CountingConsumer, "Consumer", 4096, NULL, 2, NULL, 1);

  // Create Mutex Tasks
  xTaskCreatePinnedToCore(
    CounterTask1, "Counter1", 4096, NULL, 1, NULL, 1);

  xTaskCreatePinnedToCore(
    CounterTask2, "Counter2", 4096, NULL, 1, NULL, 1);

  Serial.println("All Tasks Created Successfully");
}

void loop()
{
  vTaskDelay(pdMS_TO_TICKS(1000));
}
